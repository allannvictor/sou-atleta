{
  "name": "@sou-atleta/web",
  "version": "0.0.0",
  "private": true,
  "description": "Site do Sou Atleta: página inicial, política de privacidade e área fechada.",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc --build",
    "test": "vitest run && playwright test --trace off",
