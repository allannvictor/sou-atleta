{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sou-atleta",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  // Workers Logs DESLIGADOS nesta Worker (decisão do dono, issue #4, reafirmada na issue #5): eles
  // guardariam IP e navegador de cada visita, e a política de privacidade diz que o site não
  // coleta dados do visitante. Só a Worker de sincronização (apps/sync) liga logs, e lá eles
  // levam apenas eventos fechados, nunca dado de saúde, chave ou token (docs/decisoes/0005).
  // Um teste (apps/sync/src/configuracao.test.ts) falha se isto mudar sem a política mudar junto.
  "observability": { "enabled": false },
  // Só o endereço workers.dev principal. Os endereços por versão (Version URLs) ficam ligados
  // por padrão e não passam pelo Access do painel: desligados, só existe um endereço a proteger.
  "workers_dev": true,
  "preview_urls": false,
  // Nada sob /app pode ser servido como arquivo estático sem passar pela Worker (e pela trava de
  // acesso dela). Um teste (e2e/configuracao-de-deploy.spec.ts) também falha se o build gerar
  // qualquer arquivo cujo caminho comece com "app", em qualquer combinação de maiúsculas.
  "assets": { "run_worker_first": ["/app*", "/App*", "/APP*"] },
  // Cloudflare Access: domínio do time e etiqueta AUD da aplicação. Não são segredos
  // (a etiqueta aparece em todo JWT). A Worker confere o JWT do Access contra esses dois valores;
  // se algum ficar vazio, a rota /app recusa todo mundo. Trocar o nome do time Zero Trust muda o
  // TEAM_DOMAIN (e os endereços de retorno no login do Google): ver docs/decisoes/0005-arquitetura.md.
  //
  // EMAILS_PERMITIDOS: quem pode entrar em /app, e-mails separados por vírgula. A Worker confere
  // o e-mail do JWT contra esta lista (a política do painel sozinha não basta). Aqui só cabe o
  // e-mail do projeto, que já é público. E-mail de AMIGO NÃO ENTRA NESTE ARQUIVO: o repositório é
  // público e o histórico do git é permanente. Para o primeiro amigo, tire só esta linha do topo
  // (a do ambiente `teste` fica) e crie o secret de mesmo nome, com consentimento e a política
  // de privacidade atualizada: passo a passo em docs/decisoes/0005-arquitetura.md. Um teste
  // falha se houver outro e-mail aqui.
  // CONEXÃO COM A GARMIN (issue #5). Os dois blocos abaixo ficam COMENTADOS de propósito: o banco
  // D1 e a Worker `sou-atleta-sync` só existem depois que o dono os cria, e declarar uma ligação
  // para algo que não existe faz o deploy automático do site falhar. O site funciona sem eles
  // (a área fechada diz que a Garmin ainda não foi configurada). Passo a passo para ligar, em
  // ordem, no PR da issue #5 e em docs/decisoes/0005-arquitetura.md:
  //   1. o dono cria o D1 e troca o marcador do id em apps/sync/wrangler.jsonc;
  //   2. o dono tira o `//` das duas linhas abaixo e põe o MESMO id no D1.
  // O site só LÊ o banco e só PEDE à sync que atualize; ele nunca recebe a chave da Garmin.
  // Um teste (apps/sync/src/configuracao.test.ts) confere que os dois arquivos combinam.
  //
  // "d1_databases": [{ "binding": "DB", "database_name": "sou-atleta", "database_id": "COLOQUE-AQUI-O-ID-DO-D1" }],
  // "services": [{ "binding": "SYNC", "service": "sou-atleta-sync" }],
  //
  "vars": {
    "TEAM_DOMAIN": "https://broad-term-ec6b.cloudflareaccess.com",
    "POLICY_AUD": "bbb3a6453516e33802697e799fb882d11e43e0ae5eaf8a8375418dd2b6dc6b7e",
    "EMAILS_PERMITIDOS": "souatletaapp@gmail.com",
  },
  "env": {
    // Só para os testes de interface (CLOUDFLARE_ENV=teste). Valores de mentira: nenhuma chave
    // de Access existe para eles, então nenhum JWT consegue ser válido neste ambiente. A lista de
    // e-mails também só tem o e-mail do projeto: a regra "nenhum e-mail de terceiros neste
    // arquivo" vale para o arquivo inteiro.
    "teste": {
      "vars": {
        "TEAM_DOMAIN": "https://sou-atleta-teste.cloudflareaccess.com",
        "POLICY_AUD": "etiqueta-aud-de-teste",
        "EMAILS_PERMITIDOS": "souatletaapp@gmail.com",
      },
    },
  },
}
