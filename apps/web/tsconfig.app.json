{
  "extends": "../../tsconfig.base.json",
  "include": [".react-router/types/**/*", "app/**/*", "workers/**/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/workers-types"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"]
  }
}
