{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH"]
    }
  }
}
